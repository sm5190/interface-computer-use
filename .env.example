# ---------------------------------------------------------------------------
# LegacyBank synthetic target application
# ---------------------------------------------------------------------------

LEGACYBANK_HOST=127.0.0.1
LEGACYBANK_PORT=8000
LEGACYBANK_BASE_URL=http://127.0.0.1:8000

# Development-only secret used by the synthetic local application.
# Do not reuse this value outside the local demo.
LEGACYBANK_SESSION_SECRET=dev-only-change-me


# ---------------------------------------------------------------------------
# Computer-use runtime
# ---------------------------------------------------------------------------

CUA_BROWSER=chromium
CUA_HEADLESS=false
CUA_EVIDENCE_DIR=evidence/dev


# ---------------------------------------------------------------------------
# Discovery model
# ---------------------------------------------------------------------------

DISCOVERY_PROVIDER=gemini
DISCOVERY_MODEL=gemini-3.6-flash

# Put the real value in .env only.
# Never commit the API key.
GEMINI_API_KEY=